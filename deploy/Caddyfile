# 生产环境的 HTTPS 入口：Caddy 自动向 Let's Encrypt 申请并续期证书，HTTP 自动跳转到 HTTPS。
# 浏览器只有在 HTTPS 下才允许使用麦克风。

{$EIDOLON_DOMAIN} {
	# 导入数据包是一个最大 200 MiB 的请求体，后端自己会拒绝更大的、说清楚为什么；这里比它
	# 略宽，只挡远远超出的。只卡这一个地址，别的不动
	request_body /api/account/data-package {
		max_size 201MiB
	}
	# 只压缩 JSON：对话回复是流式的（SSE），要随到随发，不压缩；页面 Next 自己压缩，
	# 数据包是 zip、头像是图片，压了也没用
	encode {
		zstd
		gzip
		match {
			header Content-Type application/json*
		}
	}
	reverse_proxy 127.0.0.1:3000
}
