# 复制为 .env 后填写。docker compose up 会把它传给后端。
# 设了管理者（EIDOLON_ADMINS）时，模型、key、限额等很多项也可以在网站的后台里改：后台改过的项优先于这里，
# 之后再改这里的同一项不会生效，要先在后台把它恢复成 .env 的值（启动日志会列出哪些项被后台覆盖了，见 docs/deploy.md「后台」）

# 对话模型。接口类型 CHAT_LLM_PROTOCOL 三选一（不填为 chat-completions）：
#   chat-completions  OpenAI 兼容的 Chat Completions 接口（请求 {地址}/chat/completions）
#   responses         OpenAI Responses 接口（请求 {地址}/responses）
#   anthropic         Anthropic Messages 接口（请求 {地址}/messages，例如地址填 https://api.anthropic.com/v1）
# 对话模型必须支持流式输出和工具调用：后端启动时会发一次很小的检查请求，不满足就拒绝启动并说明原因
CHAT_LLM_PROTOCOL=
CHAT_LLM_BASE_URL=https://api.openai.com/v1
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
# 每次回复的长度上限（可选，单位 token）。Anthropic 接口必须有上限，不填时为 16384；另两种接口不填就不限制。
# 这一项两个模型各自设置，后台模型不沿用对话模型的上限
CHAT_LLM_MAX_TOKENS=
# 思考强度（可选）：none（关闭）、minimal、low、medium、high、xhigh、max 之一，按接口原样发给服务；不填就不发，交给模型自己的默认。
# Anthropic 接口没有 minimal。服务不支持这一档时，启动检查会报出来。选 high 及以上时，回复长度上限留空或设宽裕一些，思考也算在上限里
CHAT_LLM_REASONING_EFFORT=
# 通话里的思考强度（可选），写法同上，上面那一项只管文字对话。不填就不发，不沿用上面那一项；想让她在通话里开口快一些，可以只把这一项设成 none 或 low。
# 两项不同时，启动检查各查一次
CHAT_LLM_CALL_REASONING_EFFORT=
# 额外请求参数（可选）：一个 JSON 对象，深合并进每次请求，能覆盖思考强度生成的参数，例如 {"enable_thinking": false}。
# 不能包含 model、stream、stream_options、messages、input、instructions、system、tools、tool_choice。用它控制思考时，思考强度留空
CHAT_LLM_EXTRA_BODY=

# 后台模型：在对话后抽取关于用户的记忆、给对话起标题，也用来生成人设初稿，接口类型同样三选一。
# 除了 BACKGROUND_LLM_MAX_TOKENS、BACKGROUND_LLM_REASONING_EFFORT 和 BACKGROUND_LLM_EXTRA_BODY，每一项都可以不填，不填的沿用对话模型的设置（包括接口类型）；例如只填 BACKGROUND_LLM_MODEL，就是在同一个服务上换一个便宜的模型。
# 换到另一种接口的服务时，记得同时填 BACKGROUND_LLM_PROTOCOL
BACKGROUND_LLM_PROTOCOL=
BACKGROUND_LLM_BASE_URL=
BACKGROUND_LLM_API_KEY=
BACKGROUND_LLM_MODEL=
BACKGROUND_LLM_MAX_TOKENS=
# 后台模型自己的思考强度和额外请求参数，写法同上；不填就不发，不沿用对话模型的。
# 启动时不检查后台模型：服务不支持这一档时，要等提炼记忆、起标题、起草人设时才会失败（在后台保存时会检查）
BACKGROUND_LLM_REASONING_EFFORT=
BACKGROUND_LLM_EXTRA_BODY=

# 语音通话：语音识别（Soniox 或阿里云百炼）和语音合成（Fish Audio）。两项都填了才能语音通话，否则只能文字对话。
# 语音识别部署时用 STT_PROVIDER 二选一（ADR-0010；用户自带语音识别密钥时自己选，不受这里影响）：
#   soniox   Soniox（默认），用 SONIOX_API_KEY
#   bailian  阿里云百炼的实时语音识别，用 DASHSCOPE_API_KEY。注意：
#            - 北京、新加坡地域的 key 都可以，后端自动判断（先试北京，再试新加坡）；北京地域有免费额度
#            - 先在阿里云百炼控制台开通 BAILIAN_STT_MODEL 指定的模型
#            - 填了 key 但调不通（两个地域都拒绝、模型没开通、连不上）时，后端拒绝启动并说明原因
#            - 公开部署用北京地域的 key 时，用户的声音会送到中国内地处理和保存，隐私说明里写明了这一点
STT_PROVIDER=
SONIOX_API_KEY=
DASHSCOPE_API_KEY=
# 阿里云百炼的语音识别模型（可选）。目前只能是默认的 qwen-audio-3.1-asr-flash-streaming，填其他值后端拒绝启动
BAILIAN_STT_MODEL=
FISH_AUDIO_API_KEY=
# Fish Audio 的合成模型（可选），只能是 s2.1-pro-free、s2.1-pro、drama-3、s2-pro、s1，填其他值后端拒绝启动。
# 默认 s2.1-pro-free 不消耗 API 额度；s2.1-pro、drama-3 等付费模型要有 API 余额。通话用 drama-3 时，她会写更细的语气提示
FISH_AUDIO_MODEL=

# WebRTC 的 STUN/TURN 服务器（可选，默认用 Google 的公共 STUN；生产部署默认用自带的 coturn）。
# 逗号分隔的地址，或 JSON 列表（TURN 需要 username 和 credential），例如：
# EIDOLON_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478"],"username":"u","credential":"p"}]
EIDOLON_ICE_SERVERS=
# 和后端共用密钥的 TURN 服务器（可选，coturn 的 use-auth-secret）：后端给每位用户签发 24 小时后过期的凭据，
# 密钥本身不发给浏览器。EIDOLON_TURN_URLS 是逗号分隔的 turn: 地址；生产部署总是用自带的 coturn（这里填的地址不生效），只需要填密钥
EIDOLON_TURN_URLS=
EIDOLON_TURN_SECRET=

# 向量化服务（剧情库、角色资料和记忆都用它向量化；同步或导入剧情库时也需要），部署时二选一（ADR-0005）：
#   siliconflow  硅基流动的 Qwen3-Embedding（默认），用 SILICONFLOW_API_KEY
#   gemini       Google 的 Gemini Embedding 2，用 GEMINI_API_KEY。注意：
#                - Gemini API 不对中国大陆、香港、澳门开放，服务器要在其他地区
#                - 免费层的内容会被 Google 用于改进产品（送去向量化的包括剧情库和用户的记忆）；介意的话开通计费，付费层不用于训练
#                - 重排仍然在硅基流动，SILICONFLOW_API_KEY 照样要填
# 更换服务、模型或维度后重启后端，再运行 eidolon reembed 用库里的原文重新向量化，不需要重新导入剧情库
EMBEDDING_PROVIDER=
# 向量化模型（可选，默认硅基流动 Qwen/Qwen3-Embedding-0.6B，Gemini gemini-embedding-2）。换服务时记得清空或改成新服务的模型
EMBEDDING_MODEL=
# Gemini 的向量维度（可选，只对 gemini 生效，默认 1536，可填 128–3072）
EMBEDDING_DIMENSIONS=
GEMINI_API_KEY=
# 公开部署（填了 EIDOLON_DOMAIN）用 Gemini 时，开通计费后填 1 声明（ADR-0005 的修订）；不填时后端启动会警告：免费层会把用户的记忆交给 Google 用于改进产品
GEMINI_BILLING_ENABLED=
# Gemini API 的接口地址（可选，默认 https://generativelanguage.googleapis.com/v1beta）
GEMINI_BASE_URL=

# 硅基流动：Qwen3-Reranker 做对话中检索结果的重排（选 siliconflow 时也用它向量化）
SILICONFLOW_API_KEY=
# 重排模型（可选，默认 Qwen/Qwen3-Reranker-0.6B；也可以用 Qwen/Qwen3-Reranker-4B，国际站已把它标为 Deprecated，国内站 api.siliconflow.cn 仍提供）
RERANK_MODEL=
# 重排阈值（可选，0 到 1）：重排分数低于它的剧情/角色资料/作品资料（RERANK_MIN_RELEVANCE）或记忆（RERANK_MEMORY_MIN_RELEVANCE）
# 不放进提示词。不填时按重排模型取校准过的值：0.6B 为 0.3 / 0.01，4B 为 0.7 / 0.005；其他模型用 4B 的值，启动时会提示。
# 想自己校准可以运行 eidolon eval rerank（见 docs/deploy.md）
RERANK_MIN_RELEVANCE=
RERANK_MEMORY_MIN_RELEVANCE=
# 硅基流动的接口地址（可选，默认 https://api.siliconflow.cn/v1）
SILICONFLOW_BASE_URL=

# 判断模型（检索判断、好感度和通话中的情绪判断都用它）：jev（默认）、cloudflare（Workers AI 上的 Clef）
# 或 bailian（阿里云百炼的决策模型），只选一家
JUDGE_PROVIDER=
# JUDGE_PROVIDER=cloudflare 时必填：Cloudflare 的 API token（需要 Workers AI 的 Read 和 Edit 权限）和 account id，
# 在 Dashboard 的 Workers AI 页面选 Use REST API，创建 token、复制 Account ID；
# 启动时会试一次，被拒就不启动并说明是哪一项不对；此时下面的 JEV_* 都不用
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# clef 或 clef-flash（可选，默认 clef-flash）：clef-flash 更快、更便宜（$0.09/M 输入 token），
# clef 检索判断更准（$0.24/M）。每天有 10,000 neurons 的免费额度，约够 clef-flash 判断 2,000 次、clef 750 次（打开了好感度时每次判断更长，约 860 次、320 次）；
# 通话中每段回复都要判断一次情绪，公开部署应开 Workers Paid，否则额度用完后当天检索照常进行、立绘不再换表情、好感度不再变化
CLOUDFLARE_JUDGE_MODEL=
# JUDGE_PROVIDER=bailian 时必填：阿里云百炼业务空间的 API key 和业务空间 ID（控制台「业务空间管理」里能看到，形如 llm-xxxx），
# key 必须属于这个业务空间；和语音识别的 DASHSCOPE_API_KEY 分开填。只支持按量付费的业务空间，不支持 Token Plan 的 sk-sp- key。
# 启动时会试一次，被拒就不启动并说明是哪一项不对；此时下面的 JEV_* 都不用
BAILIAN_JUDGE_API_KEY=
BAILIAN_JUDGE_WORKSPACE_ID=
# 业务空间所在的地域：beijing 或 singapore（可选，默认 beijing）
BAILIAN_JUDGE_REGION=
# 决策模型的模型名（可选，默认 decision-model-preview，预览版限时免费）
BAILIAN_JUDGE_MODEL=

# 对话中的检索判断：Jev（TypeSafe），默认经由 OpenRouter 调用，填 OpenRouter 的 key。
# 它（或者 JUDGE_PROVIDER=cloudflare、bailian 那几项）和向量化服务的 key、SILICONFLOW_API_KEY 都填了，角色才会在对话中检索剧情、角色资料和记忆（也才会记住用户说过的事），否则只凭人设回复
# （旧的 AI_GATEWAY_API_KEY 已改名为 JEV_API_KEY，只配旧变量时后端不会启动）
JEV_API_KEY=
# Jev 的模型名（可选，默认 typesafe/jev-1.13，锁定版本，是 OpenRouter 的写法；换了渠道要改成那一家的写法：
# TypeSafe 直连是 jev-1.13.0，Vercel 的以 Vercel 文档为准）。
# 设成 cloudflare/clef-flash 或 cloudflare/clef 也能经 OpenRouter 用上 Clef（花 OpenRouter 余额，没有免费额度）
JEV_MODEL=
# Jev 的 System One 接口地址（可选，默认 https://openrouter.ai/api/v1）
# 改用 Vercel AI Gateway（要先购买额度，免费额度不能调用 Jev）：https://ai-gateway.vercel.sh/typesafe/v1
# 直连 TypeSafe：https://api.typesafe.ai/v1
JEV_BASE_URL=
# 通话中立绘的情绪：配好了判断模型（Jev、Cloudflare 或百炼）就会逐段判断（和检索是否开启无关，用 Jev 时费用约每段 $0.00003）。
# 概率最高的情绪低于 JUDGE_EMOTION_MIN_PROBABILITY（0 到 1，不填按所选模型的默认值：Jev 0.5，Clef、Clef-flash 和百炼 0.4）时按「平静」处理、也不点头；
# 超过 JUDGE_EMOTION_TIMEOUT 秒（默认 1.5）还没判断出来的段不换表情，也不重试
# （旧的 JEV_EMOTION_MIN_PROBABILITY、JEV_EMOTION_TIMEOUT 已改名，配了旧变量时后端不会启动）
JUDGE_EMOTION_MIN_PROBABILITY=
JUDGE_EMOTION_TIMEOUT=

# 生图（可选）：制作人在文字回合或通话里明确要照片时，角色发来一张拍到她本人的照片。
# 填了 NOVELAI_API_KEY（NovelAI 的持久 API token，或中转给的 key）才开启，还要配好上面的判断模型；
# 角色在 characters.toml 里要有 photo_tag 和 photo_appearance。没填时一切和原来一样，她不提照片。
# 中转要原样返回 832×1216 的图。这几项后台配置页「生图」标签也可以改，保存时会真生成一张来检查
NOVELAI_API_KEY=
# 接口形式（可选，默认 novelai）：novelai 是 NovelAI 官方格式（POST /ai/generate-image，返回 ZIP），
# openai 是 OpenAI 图像格式（POST /images/generations，返回 b64_json 或 url）。不会自动探测
NOVELAI_API_FORMAT=
# 接口地址（可选，默认 https://image.novelai.net）：官方格式填到域名根，OpenAI 图像格式填到 /v1
NOVELAI_BASE_URL=
# 模型（可选，默认 nai-diffusion-5-curated），原样发给接口
NOVELAI_MODEL=
# 这个 key 同时生成几张（可选，1 到 10，默认 1）。NovelAI 官方一个 token 同时只能一张
NOVELAI_CONCURRENCY=
# 画风（可选，默认空）：原样插在作品 tag 后面，可以带数值加权和多位画师，比如 0.7::artist:xxx::
NOVELAI_STYLE=

# 按用户限流（可选）：每位用户每小时最多发起多少次文字对话回合和语音通话，不论从哪台设备、用哪种登录方式都合并计算。
# 不填时文字对话每小时 60 次、语音通话每小时 5 次；填 0 表示不限制。超过限额时前端会提示什么时候可以再用。
# 用自带 LLM 的文字回合、带齐了免限额密钥（见下）的通话不计入
EIDOLON_TURNS_PER_HOUR=
EIDOLON_CALLS_PER_HOUR=
# 每位用户每小时最多收到几张照片（可选，默认 5，0 表示不限），文字回合和通话共用；没发出来的照片不算
EIDOLON_PHOTOS_PER_HOUR=
# 免限额密钥（可选，不填或 1 表示选上；0 表示不选；其他值启动时报错）：通话把选上的几项都用了自带密钥就不计入上面的限额，
# 没选的由部署者承担；文字回合不看这三项，用了自带 LLM 就不计入。默认三项都选，也就是三项都自带的通话才不计入。
# 至少选一项，三项都是 0 时拒绝启动（想取消限额，把上面两项设成 0）。比如只选 LLM：带了自己 LLM 的人打电话不受限额，语音由你出。
# 后台配置页「限额」一节可以改，详见 docs/configuration.md 的「登录、用户与限额」
EIDOLON_EXEMPTING_LLM=
EIDOLON_EXEMPTING_TTS=
EIDOLON_EXEMPTING_STT=
# 单次语音通话最长多少分钟、最多多少轮（可选，不填时 10 分钟、40 轮；填 0 表示不限制）。
# 到了上限，角色把正在说的话说完后挂断，前端会说明原因
EIDOLON_CALL_MINUTES=
EIDOLON_TURNS_PER_CALL=

# 好感度和礼物（可选，不填时 1 表示打开；0 表示关闭）。打开后，判断模型每个回合判断用户的话让角色的好感度怎样变化，
# 好感度跌到底时进入冷却，暂时不能和这位角色说话、通话中她会挂断；用户每天得到一次抽奖次数，抽到礼物送给她，送礼会加好感度。
# 需要配好判断模型（上面的 JEV_API_KEY、Cloudflare 或百炼的几项），没配时好感度和礼物整块关闭。抽奖和送礼不调用任何模型，不增加费用。
# 关掉时不判断、不显示、冷却不拦人、不能抽奖和送礼，已有的数据原样留着。后台配置页「好感度和礼物」卡可以改
# 详见 docs/configuration.md 的「好感度和礼物」
EIDOLON_AFFINITY_AND_GIFTS=

# 搭话（可选，不填时 0 表示关闭；1 表示打开）。打开后，用户一阵子没来，角色会在当前对话里先说几句。
# 用的是部署者的对话模型，花费由部署者出，用户自带了 LLM 也一样。每位用户每天最多几次在后台配置页「搭话」卡里改（默认 3 次）
EIDOLON_REACH_OUTS=

# 来信（可选，不填时 0 表示关闭；1 表示打开）。打开后，偶像会在特别的日子和平时偶尔给制作人写信，放进「信箱」。
# 用的是部署者的对话模型，花费由部署者出。每位用户每天最多收 3 封。
EIDOLON_LETTERS=

# 每个回合发给对话模型的历史回合数的下限（可选，不填时 20；填 0 表示整段对话都带上）。
# 攒到下限加一半时一次砍回下限，所以实际带 20 到 29 回合，好让服务商的缓存接得上。
# 更早的内容靠记忆和检索接上；对话记录本身不受影响
EIDOLON_HISTORY_TURNS=

# 制作人所在地的天气（可选，两个一起填；都不填就没有天气，其它一切照旧）。
# 填纬度和经度，北纬、东经为正，例如北纬 31.23、东经 121.47 写作 31.23 和 121.47。
# 打开后每个回合问一次 Open-Meteo（免费、不要密钥），把「制作人那边现在下着小雨，12°C。」告诉她；
# 通话里环境音选「自动」时，判断模型也会参考真实天气（下雨时更可能放雨声）。
# 天气 30 分钟内只问一次；问不到就不提天气，绝不会让对话或通话因此失败。
EIDOLON_WEATHER_LAT=
EIDOLON_WEATHER_LON=

# 联网搜索（可选）。不填就用聊天模型那一把钥匙和 DeepSeek 的搜索接口，所以用 DeepSeek 部署的不用改这里。
# 加这两个是为了把搜索单独拆出来：换成 OpenAI / Anthropic / Gemini 的对话模型时，搜索照旧能用。
# EIDOLON_SEARCH_KEY：搜索用的 API key。
# EIDOLON_SEARCH_URL：搜索接口的地址。
# 用户那边每个角色一个「联网」开关，默认关着；没配搜索钥匙时界面上没有这一项。
# EIDOLON_SEARCH_KEY=
# EIDOLON_SEARCH_URL=https://api.deepseek.com/v1/tools/search

# 网络代理（可选）。服务器连不上某些服务商（比如 OpenAI、Soniox）时，让这些服务经过代理连，其余的直连。
# EIDOLON_PROXY_URL：http://、https://、socks5:// 或 socks5h:// 开头，写明主机和端口，可以带用户名和密码；不填就没有代理。
# 生产环境的后端和宿主机共用网络，宿主机上的代理直接写，比如 http://127.0.0.1:7890
# EIDOLON_PROXY_SERVICES：走代理的服务，逗号分隔：chat_llm（扮演角色的 LLM）、memory_llm（后台模型）、judge（判断模型）、
# embedding（向量化）、rerank（重排）、tts（语音合成）、stt（语音识别）、image（生图）、web_search（联网搜索），
# 用户自带的 own_llm、own_tts、own_stt、own_image，或者 all 表示全部。自带的 LLM 只在服务地址属于已知服务商时才走代理，
# 自带的生图只有 NovelAI 官方地址走代理。
# HTTPS_PROXY 等环境变量对这几项不起作用。后台配置页「网络」标签可以改
# 详见 docs/configuration.md 的「网络代理」
EIDOLON_PROXY_URL=
EIDOLON_PROXY_SERVICES=

# 服务状态（可选）：对话列表铃铛旁边给用户看各项服务现在正不正常。按最近一段时间里用部署者 key 的调用算出错率，
# 这段时间里没有调用的服务，后台用最小的真实请求试一下（不进运行记录）；生图不试。
# EIDOLON_STATUS_SERVICES：显示哪些服务，逗号分隔，名字同上面的前八项（chat_llm … image），不填或 all 是全部，none 是都不显示；
# 部署里没配的服务自动不显示。EIDOLON_STATUS_WINDOW_MINUTES：统计最近多少分钟，10、30 或 60，不填是 30。
# 后台配置页「服务状态」标签可以改。详见 docs/configuration.md 的「服务状态」
EIDOLON_STATUS_SERVICES=
EIDOLON_STATUS_WINDOW_MINUTES=

# 登录（ADR-0006）：用户用 GitHub 或 Google 登录，至少配置一家；创建 OAuth 应用的步骤和回调地址见 docs/deploy.md 的「配置 OAuth 应用」。
# 只配了一家时，登录页只显示那一种
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 加密后台里保存的 key、给封禁名单做哈希用的密钥，用 openssl rand -hex 32 生成；不填时后台里的 key 只能看不能改。
# 用户的自带密钥只存在他们的浏览器里，跟它无关，不填也能用（ADR-0017）。
# 填了之后不要更换，否则后台里保存的 key 无法解密，被删除的封禁用户也能重新注册
EIDOLON_SECRET_KEY=
# 开发登录：填 1 时登录页多出「开发登录」，按名字直接登录（用户不存在就创建），不需要 OAuth 应用。
# 只能在本地开发时打开：它让任何人都能冒充任何用户，配置了 EIDOLON_DOMAIN 时后端会拒绝启动
EIDOLON_DEV_LOGIN=

# 管理者（ADR-0013，可选）：能进入网站 /admin 后台的人，逗号分隔的「提供方:身份标识」，提供方是 github 或 google，
# 例如 github:12345,google:109876543210。按登录方式认定，不按邮箱；同一位用户绑定的登录方式里有一个在名单里就算。
# 找自己的标识：先在网站上登录一次，再在服务器上运行 eidolon user list（Docker 部署：docker compose exec backend eidolon user list），
# 每个登录方式后面括号里的就是。不填时后台整个不存在；名单只能在这里改，后台里不能增减
EIDOLON_ADMINS=

# 联系方式（可选），例如一个邮箱地址：被封禁的用户登录时，「已被封禁」的提示后面附上这一句，让他知道该找谁；
# 隐私政策的末尾也显示它。不填时都不显示
EIDOLON_CONTACT=

# 通话层立绘素材的公开访问地址（可选），即存放立绘的 S3 兼容存储桶的 URL，例如 https://stand.example.com。
# 角色在 characters.toml 里配了 idol_id 和 default_outfit、这里也填了，通话层才叠上立绘；不填时只显示背景图。
# 存储桶要公开可读、配 CORS 允许网站的域名，结构和设置见 docs/deploy.md「立绘素材」。
# 本地开发时可以不用存储桶：npx http-server corpus/stand/source/assets -p 8765 --cors，这里填 http://localhost:8765
EIDOLON_STAND_ASSETS_URL=

# 立绘素材的同步（deploy/stand-sync.sh，从 ShinyColorsDB 拉取，不经过 docker；后端本身不用这些）。
# 落地页的招呼和开场白（eidolon greeting upload）用上面的 FISH_AUDIO_API_KEY 合成，也上传到下面的存储桶，见 docs/deploy.md「招呼」。
# 拉取的立绘（source/）、衣装清单和缩略图的整理目录（可选，默认是仓库根目录下的 corpus/stand，不进仓库；改的话写绝对路径）
EIDOLON_STAND_BUILD_PATH=
# 上传到的 S3 兼容存储桶：S3 接口的地址（不是公开访问地址），例如 R2 的 https://<账户 ID>.r2.cloudflarestorage.com、
# 腾讯云 COS 的 https://cos.ap-shanghai.myqcloud.com、阿里云 OSS 的 https://oss-cn-hangzhou.aliyuncs.com
EIDOLON_STAND_S3_ENDPOINT=
EIDOLON_STAND_S3_BUCKET=
# 能写这个存储桶的访问密钥
EIDOLON_STAND_S3_ACCESS_KEY_ID=
EIDOLON_STAND_S3_SECRET_ACCESS_KEY=
# 签名用的地域（可选，默认 us-east-1，R2 和 MinIO 用默认即可；COS、OSS、AWS 填存储桶所在的地域，例如 ap-shanghai）
EIDOLON_STAND_S3_REGION=
# 存储桶的寻址方式（可选）：path（默认，https://地址/存储桶/文件）或 virtual（https://存储桶.地址/文件，阿里云 OSS、腾讯云 COS 要用这个）
EIDOLON_STAND_S3_ADDRESSING=
# 同步日志的位置（可选，默认 logs/stand-sync.log）
EIDOLON_STAND_SYNC_LOG=

# 数据库的每天备份（deploy/db-backup.sh 在后端容器里运行 eidolon backup，ADR-0012），步骤见 docs/deploy.md「备份」。
# 备份放在单独的 S3 兼容存储桶里（推荐 Cloudflare R2）。这个存储桶必须是私有的，不要开公开访问，
# 也不要和立绘共用：立绘桶是公开可读的，配错一次就会把数据库泄露出去。写法同上面的 EIDOLON_STAND_S3_*
EIDOLON_BACKUP_S3_ENDPOINT=
EIDOLON_BACKUP_S3_BUCKET=
# 只能读写备份存储桶的访问密钥（R2 的 API 令牌选「对象读和写」，只指定这一个存储桶）
EIDOLON_BACKUP_S3_ACCESS_KEY_ID=
EIDOLON_BACKUP_S3_SECRET_ACCESS_KEY=
# 签名用的地域和寻址方式（可选），同 EIDOLON_STAND_S3_REGION、EIDOLON_STAND_S3_ADDRESSING
EIDOLON_BACKUP_S3_REGION=
EIDOLON_BACKUP_S3_ADDRESSING=
# 加密备份用的 age 公钥（age1 开头，age-keygen 生成）。服务器上只放公钥；私钥由你离线保存，丢了所有备份就都解不开了
EIDOLON_BACKUP_AGE_RECIPIENT=
# 心跳地址（可选）：每次备份成功后访问一次，例如 healthchecks.io 的 https://hc-ping.com/<uuid>，备份停了它会提醒你
EIDOLON_BACKUP_PING_URL=
# 保留期（可选，整数天数，1 到 30，默认 30）：过了保留期的备份每次备份时删掉，最新的一份总是保留。
# 最长 30 天是隐私政策的承诺（删除的数据最多 30 天后从备份里消失），所以只能调短，填超过 30 的数备份会以「配置不全」失败
EIDOLON_BACKUP_KEEP_DAYS=
# 空间提醒（可选，单位 GB，可以是小数，如 2.5）：存储桶里备份的总量超过它时，备份日志里记一条「注意」，备份照常成功。
# 不填就不提醒。线上一份约 77 MB，留满 30 天约 2.3 GB（2026-10-15）
EIDOLON_BACKUP_WARN_GB=
# 备份日志的位置（可选，默认 logs/db-backup.log；由主机上的脚本读取，不是后端）
EIDOLON_BACKUP_LOG=

# 生产部署（docker-compose.prod.yml，步骤见 docs/deploy.md）
# 网站的域名（需要有指向这台服务器的 A 记录，Caddy 用它自动申请 HTTPS 证书），例如 eidolon.example.com。
# 后端据此拼出登录的回调地址、只接受这个网站发来的请求、给 cookie 加上 Secure；本地开发时不要填
EIDOLON_DOMAIN=
# 这台服务器的公网 IPv4 地址：coturn 只允许把语音中继到这台服务器（也就是后端），不会被别人当作开放的中继
EIDOLON_PUBLIC_IP=
# 服务器网卡上的内网地址（可选）：只有公网地址不在网卡上时才填（AWS、阿里云、腾讯云等 1:1 NAT 的云主机，`ip addr` 看不到公网地址）
EIDOLON_PRIVATE_IP=
# coturn 的中继端口范围（可选，默认 49160-49259，防火墙要放行这些 UDP 端口）
EIDOLON_TURN_MIN_PORT=
EIDOLON_TURN_MAX_PORT=
# 前端和后端用 GHCR 上的哪一版镜像（可选，默认 main 分支最新的一版）：例如 sha-29d651a 或 1.2.0，升级出问题时用来回滚
EIDOLON_IMAGE_TAG=
